{
  "compilerOptions": {
    // Environnement / modules
    "module": "esnext",
    "target": "es2023",
    "lib": ["esnext"],
    "types": [],

    // Résolution “bundler” (plus besoin d’extensions dans les imports)
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",

    // Pas d’émission, tsc sert juste au typage
    "noEmit": true,

    // Sorties optionnelles (déclarations uniquement si besoin)
    // "emitDeclarationOnly": true,
    "sourceMap": true,
    "declaration": false,
    "declarationMap": false,

    // Typage strict
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}